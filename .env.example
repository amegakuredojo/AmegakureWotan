# .env.example — COPIAR a .env y NUNCA commitear .env
# cp .env.example .env && chmod 600 .env

# ── OBLIGATORIO ───────────────────────────────────────────────────────────
NEO4J_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ── OPCIONAL (con defaults razonables) ───────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j

# Timeout para procesos aislados (Hel/Loki) en segundos
KARASU_ISOLATION_TIMEOUT=120

# Días antes de rotar la HMAC master key del ledger forense
KARASU_KEY_ROTATION_DAYS=30

# Ejecutar smoke test en cada boot (útil para CI, costoso en producción)
KARASU_RUN_SMOKE_TEST=false

# Hash de imagen — se genera automáticamente con el Makefile
KARASU_IMAGE_HASH=dev
BUILD_DATE=unknown
