# .env.example — COPIAR a .env y NUNCA commitear .env
# cp .env.example .env && chmod 600 .env
# FORGE_CONTEXT: CIVIL | FORGE_VERSION: 3.0

# ── PRODUCCIÓN (valores de producción recomendados) ───────────────────────

# Timeout para procesos aislados (Hel/Loki) en segundos
KARASU_ISOLATION_TIMEOUT=120

# Días antes de rotar la HMAC master key del ledger forense
KARASU_KEY_ROTATION_DAYS=30

# Ejecutar smoke test en cada boot (útil para CI, costoso en producción)
KARASU_RUN_SMOKE_TEST=false

# Hash de imagen — se genera automáticamente con el Makefile
KARASU_IMAGE_HASH=dev
BUILD_DATE=unknown

# ── MCP SERVER ────────────────────────────────────────────────────────────

# Suprimir banners de boot (RECOMENDADO para MCP — evita contaminar JSON-RPC)
KARASU_SILENT_BOOTSTRAP=false

# Timeout máximo esperando Tor en modo MCP (segundos). Default: 10s
KARASU_MCP_TOR_TIMEOUT=10

# ── SANDBOX / DEV / CI (NO USAR EN PRODUCCIÓN) ────────────────────────────

# Bypass del kill switch Tor para sandboxes y entornos sin Tor disponible.
# false (default) = kill switch activo (modo producción OPSEC)
# true = Hel/Loki operan sin Tor — SOLO sandbox/dev/CI
KARASU_OPSEC_BYPASS_TOR=false

# ── DOCKER SANDBOX EXTERNO ────────────────────────────────────────────────
# Usado con docker-compose.sandbox.yml

# Path de datos del sandbox (default: /tmp/karasu_sandbox)
# SANDBOX_DATA_PATH=/tmp/karasu_sandbox

# URL de SearXNG externo (si se tiene instancia propia o pública)
# SANDBOX_SEARXNG_URL=http://localhost:8080/search
